# =================================================================
# NyayaAI - Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose up -d --build
# =================================================================

# ---- Ports ----
BACKEND_PORT=5000
ML_SERVICE_PORT=8000
# Frontend runs on 5173 by default in docker-compose.yml

# ---- Frontend Build Config ----
# When running locally via Docker:
VITE_API_BASE_URL=http://localhost:5000/api
# When deploying to domain / server:
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# ---- Backend Security & Auth ----
# Mandatory: generate a secret with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=super_secret_jwt_key_at_least_16_characters_long_change_me
JWT_EXPIRES_IN=7d

# ---- Frontend & CORS URLs ----
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:80

# ---- Database (Internal Docker network or external MongoDB Atlas URI) ----
MONGODB_URI=mongodb://mongo:27017/nyaya_ai
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nyaya_ai?retryWrites=true&w=majority

# ---- ML Service URL ----
ML_SERVICE_URL=http://ml-service:8000

# ---- External Indian Kanoon API (Optional) ----
KANOON_API_TOKEN=
KANOON_API_BASE_URL=https://api.indiankanoon.org
KANOON_DEFAULT_QUERY=civil suit doctypes:judgments
KANOON_AUTO_SYNC_ON_STARTUP=true
KANOON_AUTO_SYNC_LIMIT=60
KANOON_AUTO_SYNC_PREDICT=true

# ---- Google Gemini API for AI Summaries (Optional) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
